    "dialogue.1" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Welcome to Suncrown. First, try moving using the BLUE ANALOG."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bem-vindo(a) a Suncrown. Primeiramente tente se mover usando o ANÁLOGICO AZUL."
          }
        }
      }
    },
    "dialogue.2" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Now we need to summon some troops to defend your base, press the YELLOW BUTTON."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agora precisamos invocar tropas para defender sua base, clique no BOTÃO AMARELO."
          }
        }
      }
    },
    "dialogue.3" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Troops cost CROWNS, generated by your ALTARS — defend them at all costs."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As tropas custam COROAS, que são gerados a partir de seus ALTARES, defenda-os a todo custo."
          }
        }
      }
    },
    "dialogue.4" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hold the RED ANALOG STICK to call in nearby troops, and release it to release them."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Segure o ANÁLOGICO VERMELHO para chamar tropas próximas, e solte-o para liberá-las."
          }
        }
      }
    },
    "dialogue.5" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The moon knights are coming! Don’t let them destroy your altars, or it will be harder to create soldiers."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O inimigo está se aproximando, não deixe que destruam os altares!"
          }
        }
      }
    },
    "dialogue.6" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "They will always go after the SANCTUARY, if you lose it, it's over!"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eles sempre virão atrás do SANTUÁRIO, se perdê-lo é o fim!"
          }
        }
      }
    },
    "dialogue.7" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You must find the enemy PORTALS and destroy them, it’s the only way to win."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você deve encontrar os PORTAIS inimigos e destruí-los, é o único jeito de vencer."
          }
        }
      }
    },
    "dialogue.8" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "That’s all for now... it’s up to you!"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isso é tudo por enquanto... agora é com você!"
          }
        }
      }
    },
    "dialogue2.1" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Knights cost 2 crowns, summon them with the ORANGE BUTTON!"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os cavaleiros custam 2 coroas, invoque-os clicando no BOTÃO LARANJA!"
          }
        }
      }
    },
    "firstUserButtonNo" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
