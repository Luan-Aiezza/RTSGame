    },
    "firstUserText" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The tutorial will still be available in the game settings."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O tutorial ainda estará disponível nas configurações."
          }
        }
      }
    },
    "firstUserTitle" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Play tutorial?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jogar tutorial?"
          }
        }
      }
    },
    "intro.0" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Long ago, the Highlands were home to the gods. From its summit, Heliar, goddess of the sun, illuminated the world."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Há muito tempo, as Terras Altas eram o lar dos deuses. Onde a partir do cume, Heliar, deusa do sol, iluminava o mundo."
          }
        }
      }
    },
    "intro.1" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Below, the Zarat lived in peace worshiping the light of their goddess."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abaixo, os Zarat viviam em paz adorando a luz de sua deusa."
          }
        }
      }
    },
    "intro.2" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "But then, Heliar was betrayed by her sister, Nythra. She plunged the world into eternal cold and shadow."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mas então, Heliar foi traída por sua irmã, Nythra. Que mergulhou o mundo em frio e sombras eternas."
          }
        }
      }
    },
    "intro.3" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "However, before her fall, Heliar cast a fragment of her soul far away— a promise for whoever found it to bring her light back."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Porém, antes de sua queda, Heliar lançou um fragmento de sua alma ao longe— uma promessa para quem quer que o encontrasse trazer sua luz de volta."
          }
        }
      }
    },
    "intro.4" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The fragment was found by a child of the Zarat, now exiled. The young Ariah."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O fragmento foi encontrado por uma criança dos Zarat, agora exilados. A jovem Ariah."
          }
        }
      }
    },
    "intro.5" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Years later, now guided by her goddess’s power, Ariah begins her campaign at the Highlands’ frontier…"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anos depois, agora guiada pelo poder de sua deusa, Ariah inicia sua campanha na fronteira das Terras Altas…"
          }
        }
      }
    },
    "intro.6" : {
      "extractionState" : "manual",
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para guiar seu povo de volta ao lar, e cumprir a promessa feita."
          }
        }
      }
    },
    "multiplayer" : {
      "comment" : "Title of a button that allows the user to play in multiplayer mode.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "multiplayer"
          }
        }
      }
    },
    "paragraph.0" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ariah finally conquers the Highlands frontier, after defeating the servants of Nythra."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ariah enfim conquista as fronteiras das Terras Altas, após derrotar os servos de Nythra."
          }
        }
      }
    },
    "paragraph.1" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thus, reclaiming part of her people’s territory, who could now return to live at the foot of the mountain."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Assim, recuperando parte do território de seu povo, que agora poderia voltar a residir ao pé do monte."
          }
        }
      }
    },
    "paragraph.2" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "However... a long path still lies ahead, Ariah must still climb to the top and face Nythra."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Porém… há de faltar um longo caminho, Ariah ainda haveria de subir ao topo e enfrentar Nythra."
          }
        }
      }
    },
    "paragraph.3" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thus to free the world from cold and darkness."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para assim libertar o mundo do frio e da escuridão."
          }
        }
      }
    },
    "paragraph.4" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ariah’s journey will continue..."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A jornada de Ariah continuará…"
          }
        }
      }
    },
